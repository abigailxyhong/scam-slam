{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/feedback/layout,_N_T_/feedback/correct/layout,_N_T_/feedback/correct/page,_N_T_/feedback/correct"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/feedback/correct/__PAGE__",
    "/feedback/correct",
    "/feedback",
    "/_index",
    "/_head"
  ]
}