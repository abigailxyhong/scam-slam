{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/feedback/correct",
      "regex": "^/feedback/correct(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/feedback/correct(?:/)?$"
    },
    {
      "page": "/feedback/incorrect",
      "regex": "^/feedback/incorrect(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/feedback/incorrect(?:/)?$"
    },
    {
      "page": "/feedback/time-out",
      "regex": "^/feedback/time\\-out(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/feedback/time\\-out(?:/)?$"
    },
    {
      "page": "/game-complete",
      "regex": "^/game\\-complete(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/game\\-complete(?:/)?$"
    },
    {
      "page": "/game-start",
      "regex": "^/game\\-start(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/game\\-start(?:/)?$"
    },
    {
      "page": "/instructions",
      "regex": "^/instructions(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/instructions(?:/)?$"
    },
    {
      "page": "/leaderboard",
      "regex": "^/leaderboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/leaderboard(?:/)?$"
    },
    {
      "page": "/name-input",
      "regex": "^/name\\-input(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/name\\-input(?:/)?$"
    },
    {
      "page": "/questions",
      "regex": "^/questions(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/questions(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments",
    "clientParamParsing": false,
    "dynamicRSCPrerender": false
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}